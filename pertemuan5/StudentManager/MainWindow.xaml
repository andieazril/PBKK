<Window
    x:Class="StudentManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Student Management System"
    Width="1200" Height="750"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1565C0" CornerRadius="10"
                Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="STUDENT MANAGEMENT SYSTEM" Foreground="White"
                           FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Manage student data" Foreground="White"
                           FontSize="14" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <!-- Informasi (horizontal) -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1"
                CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="INFORMASI" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                <UniformGrid Rows="1">
                    <StackPanel>
                        <TextBlock Text="Total Mahasiswa"/>
                        <TextBlock Text="{Binding TotalStudents}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Informatika"/>
                        <TextBlock Text="{Binding TotalInformatika}" FontSize="28"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Sistem Informasi"/>
                        <TextBlock Text="{Binding TotalSistemInformasi}" FontSize="28"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Laki-laki"/>
                        <TextBlock Text="{Binding TotalLakiLaki}" FontSize="28"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Perempuan"/>
                        <TextBlock Text="{Binding TotalPerempuan}" FontSize="28"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Form (kiri) + Data (kanan) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form input -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1"
                    CornerRadius="10" Padding="15" Margin="0,0,15,0"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="NIM"/>
                    <TextBox Text="{Binding EditStudent.NIM, UpdateSourceTrigger=PropertyChanged}"
                             Padding="5" Margin="0,2,0,8"/>

                    <TextBlock Text="Nama"/>
                    <TextBox Text="{Binding EditStudent.Nama, UpdateSourceTrigger=PropertyChanged}"
                             Padding="5" Margin="0,2,0,8"/>

                    <TextBlock Text="Jurusan"/>
                    <ComboBox SelectedValue="{Binding EditStudent.Jurusan}"
                              SelectedValuePath="Content" Padding="5" Margin="0,2,0,8">
                        <ComboBoxItem>Informatika</ComboBoxItem>
                        <ComboBoxItem>Sistem Informasi</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Text="Gender"/>
                    <ComboBox SelectedValue="{Binding EditStudent.Gender}"
                              SelectedValuePath="Content" Padding="5" Margin="0,2,0,8">
                        <ComboBoxItem>Laki-laki</ComboBoxItem>
                        <ComboBoxItem>Perempuan</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Text="Email"/>
                    <TextBox Text="{Binding EditStudent.Email, UpdateSourceTrigger=PropertyChanged}"
                             Padding="5" Margin="0,2,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Simpan" Command="{Binding SaveCommand}"
                                Background="#1976D2" Foreground="White"
                                Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Hapus" Command="{Binding DeleteCommand}"
                                Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Reset" Command="{Binding ResetCommand}"
                                Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Search + DataGrid -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Cari" Command="{Binding SearchCommand}"
                            Padding="25,10"/>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Students}"
                          SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NIM" Binding="{Binding NIM}"/>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                        <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}"/>
                        <DataGridTextColumn Header="Gender" Binding="{Binding Gender}"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>